# قاعدة البيانات (Railway PostgreSQL)
DATABASE_URL=postgresql://waffir:waffir@localhost:5432/waffir

# JWT — مفتاح توقيع الجلسات (أنشئ قيمة عشوائية طويلة في الإنتاج)
JWT_SECRET=change-me-in-production

# أصل التطبيق المسموح به (CORS + الكوكيز الآمنة)
APP_ORIGIN=http://localhost:5173

# منفذ الخادم
PORT=3000

NODE_ENV=development

# Google Places API (New) — يُستخدم فقط في وظيفة اكتشاف المتاجر الشهرية،
# لا يُستدعى أبداً لكل طلب مستخدم. اتركه فارغاً لتعطيل الاكتشاف الحي
# (تعمل الوظيفة عندها على fixtures فقط).
GOOGLE_MAPS_API_KEY=
